---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LinkButtons from '../components/LinkButtons.astro';
import AuthorList from '../components/AuthorList.astro';
import { t, type Lang } from '../i18n/ui';
import { absoluteUrl, localePath } from '../i18n/utils';
import { slugOf, type PublicationEntry } from '../lib/content';
import { bibtex, breadcrumbJsonLd, scholarlyArticleJsonLd } from '../lib/seo';

interface Props { lang: Lang; entry: PublicationEntry }
const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const slug = slugOf(entry);
const path = `publications/${slug}`;
const url = absoluteUrl(localePath(lang, path));

type Link = { href: string; label: string };
const links: Link[] = [];
if (d.links.pdf) links.push({ href: d.links.pdf, label: t(lang, 'pub.pdf') });
if (d.links.arxiv) links.push({ href: d.links.arxiv, label: t(lang, 'pub.arxiv') });
if (d.links.openreview) links.push({ href: d.links.openreview, label: t(lang, 'pub.openreview') });
if (d.links.project) links.push({ href: d.links.project, label: t(lang, 'pub.project') });
if (d.links.venuePage) links.push({ href: d.links.venuePage, label: t(lang, 'pub.venuePage') });
if (d.links.code) links.push({ href: d.links.code, label: t(lang, 'pub.code') });

const venueLine = [d.venueFull ?? d.venue, d.pages ? `${t(lang, 'pub.pages')} ${d.pages}` : ''].filter(Boolean).join(' · ');
const bib = bibtex({ slug, title: d.title, authors: d.authors, year: d.year, venue: d.venue, venueFull: d.venueFull, pages: d.pages });

const jsonLd = [
  scholarlyArticleJsonLd(lang, {
    title: d.title,
    authors: d.authors,
    year: d.year,
    date: d.date,
    venue: d.venue,
    venueFull: d.venueFull,
    url,
    pdf: d.links.pdf,
    arxiv: d.links.arxiv,
    openreview: d.links.openreview,
    description: d.description,
  }),
  breadcrumbJsonLd([
    { name: t(lang, 'breadcrumb.home'), url: absoluteUrl(localePath(lang)) },
    { name: t(lang, 'publications.title'), url: absoluteUrl(localePath(lang, 'publications')) },
    { name: d.title, url },
  ]),
];
---
<Base lang={lang} title={d.title} description={d.description} path={path} jsonLd={jsonLd} ogType="article">
  <Breadcrumb lang={lang} items={[{ name: t(lang, 'publications.title'), href: localePath(lang, 'publications') }, { name: d.title }]} />
  <article>
    <header>
      <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-semibold text-accent">{d.venue}</span>
      <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{d.title}</h1>
      <AuthorList authors={d.authors} class="mt-4 text-base text-muted" />
      <p class="mt-2 text-sm text-muted">{venueLine}</p>
      <LinkButtons links={links} />
    </header>
    <h2 class="mt-10 text-xl font-semibold">{t(lang, 'pub.abstract')}</h2>
    <div class="prose mt-3 max-w-3xl">
      <Content />
    </div>
    <h2 class="mt-10 text-xl font-semibold">{t(lang, 'pub.bibtex')}</h2>
    <pre class="mt-3 overflow-x-auto rounded-xl border border-line bg-surface p-4 text-xs leading-relaxed"><code>{bib}</code></pre>
  </article>
</Base>
