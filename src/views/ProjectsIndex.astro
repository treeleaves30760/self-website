---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { t, type Lang } from '../i18n/ui';
import { absoluteUrl, localePath } from '../i18n/utils';
import { getProjects } from '../lib/content';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = await getProjects(lang);
const title = t(lang, 'projects.title');
const description =
  lang === 'en'
    ? 'Open-source projects by Po-Hsiang Hsu: CodefyUI, all-code, Journey Unfinished and pairmux, spanning deep learning education, AI coding agents and travel.'
    : '許博翔的開源專案：CodefyUI、all-code、未完旅箋與 pairmux，涵蓋深度學習教學、AI coding agent 與旅行紀錄。';
const url = absoluteUrl(localePath(lang, 'projects'));
const jsonLd = [
  collectionPageJsonLd(lang, { name: title, description, url }),
  breadcrumbJsonLd([
    { name: t(lang, 'breadcrumb.home'), url: absoluteUrl(localePath(lang)) },
    { name: title, url },
  ]),
];
---
<Base lang={lang} title={title} description={description} path="projects" jsonLd={jsonLd}>
  <Breadcrumb lang={lang} items={[{ name: title }]} />
  <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
  <p class="mt-2 text-muted">{t(lang, 'projects.intro')}</p>
  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {projects.map((entry) => <ProjectCard lang={lang} entry={entry} />)}
  </div>
</Base>
