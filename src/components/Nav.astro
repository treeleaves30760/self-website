---
import { t, type Lang } from '../i18n/ui';
import { HTML_LANG, localePath, otherLang } from '../i18n/utils';
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const other = otherLang(lang);
const current = Astro.url.pathname;
const links = [
  { href: localePath(lang, 'projects'), label: t(lang, 'nav.projects') },
  { href: localePath(lang, 'publications'), label: t(lang, 'nav.publications') },
  { href: localePath(lang, 'about'), label: t(lang, 'nav.about') },
];
const isCurrent = (href: string) => current === href || current.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/85 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-3 px-4 sm:px-6" aria-label="Main">
    <a href={localePath(lang)} class="truncate font-semibold tracking-tight text-fg hover:text-accent">{site.owner[lang]}</a>
    <div class="flex items-center gap-0.5 sm:gap-1">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined} class="rounded-md px-2 py-1.5 text-sm text-muted transition hover:bg-surface hover:text-fg aria-[current=page]:text-accent sm:px-2.5">{l.label}</a>
      ))}
      <a href={localePath(other, path)} lang={HTML_LANG[other]} hreflang={other === 'zh' ? 'zh-TW' : 'en'} aria-label={t(lang, 'nav.switchLangAria')} class="rounded-md px-2 py-1.5 text-sm text-muted transition hover:bg-surface hover:text-fg sm:px-2.5">{t(lang, 'nav.switchLang')}</a>
      <ThemeToggle lang={lang} />
    </div>
  </nav>
</header>
