---
import { t, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<button id="theme-toggle" type="button" aria-label={t(lang, 'nav.theme')} class="rounded-md p-2 text-muted transition hover:bg-surface hover:text-fg focus-visible:outline-2 focus-visible:outline-accent">
  <span class="hidden dark:inline"><Icon name="sun" class="h-5 w-5" /></span>
  <span class="inline dark:hidden"><Icon name="moon" class="h-5 w-5" /></span>
</button>
<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>
