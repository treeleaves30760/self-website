---
import Icon from './Icon.astro';
interface Props { links: { href: string; label: string }[] }
const { links } = Astro.props;
---
<ul class="mt-5 flex flex-wrap gap-2">
  {links.map((l) => (
    <li><a href={l.href} rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-medium transition hover:border-accent hover:text-accent"><span>{l.label}</span><Icon name="external" class="h-3.5 w-3.5" /></a></li>
  ))}
</ul>
