---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { t, type Lang } from '../i18n/ui';
import { otherLang } from '../i18n/utils';
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other = otherLang(lang);
const links = [
  { href: site.github, label: 'GitHub', icon: 'github' as const },
  { href: site.linkedin, label: 'LinkedIn', icon: 'linkedin' as const },
  { href: `mailto:${site.email}`, label: 'Email', icon: 'mail' as const },
];
---
<section class="flex flex-col-reverse gap-8 sm:flex-row sm:items-center sm:justify-between">
  <div class="max-w-2xl">
    <p class="text-sm font-medium uppercase tracking-wider text-accent">{t(lang, 'hero.greeting')}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{site.owner[lang]} <span class="text-2xl font-normal text-muted sm:text-3xl">{site.owner[other]}</span></h1>
    <p class="mt-4 text-lg text-muted">{site.headline[lang]}</p>
    <p class="mt-3 leading-relaxed">{site.bio[lang]}</p>
    <ul class="mt-6 flex flex-wrap gap-3" aria-label={t(lang, 'hero.contact')}>
      {links.map((l) => (
        <li><a href={l.href} rel="me noopener" class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium transition hover:border-accent hover:text-accent"><Icon name={l.icon} class="h-4 w-4" /><span>{l.label}</span></a></li>
      ))}
    </ul>
  </div>
  <Image src={avatar} alt={`${site.owner.en} (${site.owner.zh})`} width={320} height={320} loading="eager" class="h-32 w-32 shrink-0 rounded-full ring-2 ring-line sm:h-40 sm:w-40" />
</section>
