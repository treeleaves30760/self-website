---
import { t, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import { slugOf, type PublicationEntry } from '../lib/content';
import AuthorList from './AuthorList.astro';

interface Props { lang: Lang; entry: PublicationEntry }
const { lang, entry } = Astro.props;
const d = entry.data;
const href = localePath(lang, `publications/${slugOf(entry)}`);
const quick = [
  d.links.pdf && { href: d.links.pdf, label: t(lang, 'pub.pdf') },
  d.links.arxiv && { href: d.links.arxiv, label: t(lang, 'pub.arxiv') },
  d.links.project && { href: d.links.project, label: t(lang, 'pub.project') },
].filter((l): l is { href: string; label: string } => Boolean(l));
---
<article class="rounded-xl border border-line bg-surface p-5">
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-semibold text-accent">{d.venue}</span>
    <span class="text-xs text-muted">{d.year}</span>
  </div>
  <h3 class="mt-2 text-lg font-semibold leading-snug tracking-tight"><a href={href} class="hover:text-accent">{d.title}</a></h3>
  <AuthorList authors={d.authors} class="mt-2 text-sm text-muted" />
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    <a href={href} class="font-medium text-accent hover:text-accent-strong">{t(lang, 'card.more')}</a>
    {quick.map((l) => <a href={l.href} rel="noopener" class="text-muted hover:text-fg">{l.label}</a>)}
  </div>
</article>
