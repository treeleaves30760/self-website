---
import { t, type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import { slugOf, type ProjectEntry } from '../lib/content';
import Icon from './Icon.astro';

interface Props { lang: Lang; entry: ProjectEntry }
const { lang, entry } = Astro.props;
const href = localePath(lang, `projects/${slugOf(entry)}`);
const { title, description, tags, year, links } = entry.data;
---
<article class="flex h-full flex-col rounded-xl border border-line bg-surface p-5 transition hover:border-accent/60">
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-lg font-semibold tracking-tight"><a href={href} class="hover:text-accent">{title}</a></h3>
    <span class="text-xs text-muted">{year}</span>
  </div>
  <p class="mt-2 grow text-sm leading-relaxed text-muted">{description}</p>
  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tags">
    {tags.map((tag) => <li class="rounded-full border border-line px-2 py-0.5 text-xs text-muted">{tag}</li>)}
  </ul>
  <div class="mt-4 flex items-center justify-between text-sm">
    <a href={links.repo} rel="noopener" class="inline-flex items-center gap-1.5 text-muted hover:text-fg"><Icon name="github" class="h-4 w-4" /><span>{t(lang, 'project.repo')}</span></a>
    <a href={href} class="inline-flex items-center gap-1 font-medium text-accent hover:text-accent-strong"><span>{t(lang, 'card.more')}</span><Icon name="arrow" class="h-4 w-4" /></a>
  </div>
</article>
